# Configuration Sanity (ReactJS + Sanity uniquement, aucun backend)
REACT_APP_SANITY_PROJECT_ID=gacrkjml
REACT_APP_SANITY_DATASET=production

# Token Sanity avec droits d'écriture (Editor / Write)
# Nécessaire pour permettre la création de comptes membres (calMember) et le dépôt d'articles (calArticle)
REACT_APP_SANITY_WRITE_TOKEN=votre-token-sanity-write
